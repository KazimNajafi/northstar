# Copy this file to tests/.env and fill in local values.
# tests/.env is ignored by Git. scripts/setup-local.sh creates it automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_project_db
DB_USER=northstar_app
DB_PASSWORD=replace-with-the-application-password
TEST_DB_USER=northstar_test
TEST_DB_PASSWORD=replace-with-the-test-password
BASE_URL=http://localhost
